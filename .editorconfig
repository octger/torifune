# Torifune repository code style
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,axaml}]
indent_size = 4

[*.{csproj,props,targets,slnx,manifest,axaml}]
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_size = 4
