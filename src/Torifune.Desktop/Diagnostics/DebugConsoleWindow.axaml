<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diagnostics="using:Torifune.Desktop.Diagnostics"
        x:Class="Torifune.Desktop.Diagnostics.DebugConsoleWindow"
    x:DataType="diagnostics:DebugConsoleLogStore"
        Width="980"
        Height="520"
        MinWidth="700"
        MinHeight="320"
        Title="Torifune Debug Console"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*" Margin="10">
        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="全選択" Click="SelectAll_Click" />
                <Button Content="コピー" Click="CopyAll_Click" />
                <Button Content="クリア" Click="Clear_Click" />
                <TextBlock Text="内部ログ (開発者向け)" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="HeartbeatStatusTextBlock" Classes="muted" />
                <TextBlock x:Name="LastUpdateStatusTextBlock" Classes="muted" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,8,0,0" Background="#12161D" CornerRadius="6">
            <TextBox x:Name="LogsTextBox"
                     Text="{Binding AllText}"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
